{
  "name": "nexus-desktop-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "NEXUS Desktop \u2014 AI Development Environment",
  "license": "MIT",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "pnpm --filter @nexus/desktop dev",
    "start": "pnpm --filter @nexus/desktop start",
    "build": "pnpm run typecheck && pnpm --filter @nexus/desktop build",
    "package": "pnpm run build && pnpm --filter @nexus/desktop package",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @nexus/core test",
    "test:e2e": "playwright test",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm --filter @nexus/desktop build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.14.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "zod": "^4.6.7"
  }
}
